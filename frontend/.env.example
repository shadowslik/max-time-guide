# Ключ OpenRouteService для пеших маршрутов. Бесплатный, нужна регистрация
# на openrouteservice.org: 2500 запросов в сутки, 40 000 в месяц.
# Без ключа приложение работает — линия маршрута рисуется прямой.
VITE_ORS_API_KEY=

# Необязательно: ключ MapTiler для векторных тайлов с настоящей тёмной темой.
# Без него карта берёт растровые тайлы OpenStreetMap — ключ не нужен,
# а тёмная тема получается инверсией тайлов.
VITE_MAPTILER_KEY=
