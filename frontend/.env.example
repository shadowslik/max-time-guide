# Ключ JS API Яндекс.Карт 2.1. Получить: https://developer.tech.yandex.ru/services
#
# Ключ должен быть выдан именно под JS API 2.1 — ключ от версии 3.0
# вернёт 403 Invalid api key. В кабинете у ключа обязательно должно быть
# задано ограничение по HTTP Referer (для локальной разработки — localhost)
# или по IP, иначе он не активируется.
#
# Без ключа приложение работает и показывает схематичную карту вместо тайлов.
VITE_YANDEX_MAPS_API_KEY=

# Ключ «API Получения деталей маршрута» (Routing API) — ОТДЕЛЬНЫЙ платный продукт.
# Без него линия маршрута рисуется прямой, приложение работает.
# У этого API нет защиты по referer: в проде запрос обязан уйти на бэкенд.
VITE_YANDEX_ROUTER_API_KEY=
