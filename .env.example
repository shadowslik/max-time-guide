MAX_BOT_TOKEN=your_bot_token


BOT_USERNAME=your_bot_username


# Локальная разработка: RUN_BOT=0 поднимает только API (без чат-бота MAX),
# чтобы локальный бот не конкурировал с серверным за апдейты. По умолчанию 1.
RUN_BOT=1
# Порт API (по умолчанию 8000; на него смотрит прокси Vite в dev).
API_PORT=8000


# Пешие маршруты через OpenRouteService. Ключ бесплатный, нужна регистрация
# на openrouteservice.org: 2500 запросов в сутки, 40 000 в месяц.
# Без ключа приложение работает — линия маршрута рисуется прямой.
VITE_ORS_API_KEY=

# Необязательно: векторные тайлы MapTiler с настоящей тёмной темой.
# Без ключа карта берёт растровые тайлы OpenStreetMap — регистрация не нужна.
VITE_MAPTILER_KEY=
