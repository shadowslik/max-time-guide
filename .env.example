MAX_BOT_TOKEN=your_bot_token


BOT_USERNAME=your_bot_username


# Ключ JS API Яндекс.Карт (версия 2.1) для mini-app.
# В кабинете API у ключа обязательно должно быть задано ограничение
# по HTTP Referer или IP, иначе он не активируется.
# Без ключа приложение работает и показывает схематичную карту.
VITE_YANDEX_MAPS_API_KEY=

# Ключ «API Получения деталей маршрута» — ОТДЕЛЬНЫЙ платный продукт.
# Без него линия маршрута рисуется прямой. У этого API нет защиты
# по referer, поэтому в проде запрос должен уйти на бэкенд.
VITE_YANDEX_ROUTER_API_KEY=
