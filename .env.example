# ─── MAX (обязательно) ───────────────────────────────────────────────
# Токен и ник чат-бота MAX. Токен выдают организаторы хакатона.
MAX_BOT_TOKEN=your_bot_token
BOT_USERNAME=your_bot_username


# ─── Источники данных (для боевого качества подбора) ──────────────────
# 2ГИС Catalog API — ОСНОВНОЙ источник мест по всей РФ (категории, рейтинг,
# отзывы, часы работы). Без ключа бэкенд падает на ненадёжный OSM Overpass.
# Ключ: dev.2gis.com.
TWOGIS_KEY=

# DaData — геокодинг адреса (улица → дом) и определение региона/часового пояса
# по координатам. Бесплатный тариф. Ключ: dadata.ru.
DADATA_TOKEN=

# PRO.Культура.РФ — культурные события и «Пушкинская карта». Нужен PRO-ключ;
# без него события из этого источника просто не подмешиваются.
CULTURE_API_KEY=


# ─── Карта и маршрутизация (необязательно) ───────────────────────────
# Пешие маршруты через OpenRouteService (openrouteservice.org, бесплатно).
# Без ключа линия маршрута рисуется прямой.
VITE_ORS_API_KEY=

# Векторные тайлы MapTiler с тёмной темой. Без ключа карта берёт бесплатные
# тайлы OpenFreeMap — регистрация не нужна.
VITE_MAPTILER_KEY=


# ─── Запуск (необязательно) ──────────────────────────────────────────
# RUN_BOT=0 поднимает только API (без чат-бота MAX) — удобно локально,
# чтобы локальный бот не конкурировал с серверным за апдейты. По умолчанию 1.
RUN_BOT=1
# Порт API внутри контейнера (по умолчанию 8000).
API_PORT=8000
# Путь к файлу SQLite (по умолчанию backend/data/app.db, в Docker — на томе).
# DB_PATH=/app/backend/data/app.db
