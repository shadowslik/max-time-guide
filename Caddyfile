# Домен через sslip.io — автоматически указывает на IP сервера, покупать ничего не нужно.
# Формат: <IP-сервера>.sslip.io
168.113.157.47.sslip.io {
    encode gzip

    # Бэкенд появится позже. Когда добавишь сервис `api`, раскомментируй:
    # handle_path /api/* {
    #     reverse_proxy api:8000
    # }

    # Мини-приложение (React через nginx)
    reverse_proxy frontend:80
}
